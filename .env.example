# Environment Variables for TSMiddleware Lambda

# ======================
# Webex Configuration
# ======================
WXCLIENT_ID=your_webex_client_id
WXCLIENT_SECRET=your_webex_client_secret
WXCLIENT_ORGID=your_webex_org_id
WXAUTH_URL=https://webexapis.com/v1/authorize
WXCC_WEBHOOK_SECRET=your_webhook_secret
WXCC_REFRESH_TOKEN=your_refresh_token

# ======================
# CA Configuration
# ======================
CACLIENT_ID=your_ca_client_id
CACLIENT_SECRET=your_ca_client_secret
CACLIENT_SCOPE=your_ca_scope
CACASEURL=https://your-ca-case-url.com
CASTOREURL=https://your-ca-store-url.com
CAAUTH_URL=https://your-ca-auth-url.com

# ======================
# Application Configuration
# ======================
WEBHOOK_URL=https://your-api-gateway-url.execute-api.us-west-1.amazonaws.com
LOG_LEVEL=INFO
IDLE_TIMER=0

# ======================
# AWS Configuration (Optional - usually auto-configured)
# ======================
# AWS_REGION=us-west-1
# AGENTS_TABLE_NAME=tsmiddleware-dev-Agents
# CAPTURES_TABLE_NAME=tsmiddleware-dev-Captures
# SUBSCRIPTIONS_TABLE_NAME=tsmiddleware-dev-Subscriptions
# WX_TOKEN_TABLE_NAME=tsmiddleware-dev-WxToken
# CAWS_TOKEN_TABLE_NAME=tsmiddleware-dev-CawsToken
